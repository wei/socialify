{
  "name": "socialify",
  "version": "2.26.2",
  "description": "Socialify your project. Share with the world!",
  "author": "@CryogenicPlanet, @wei",
  "license": "MIT",
  "homepage": "https://socialify.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/wei/socialify.git"
  },
  "bugs": {
    "url": "https://github.com/wei/socialify/issues"
  },
  "scripts": {
    "predev": "pnpm copy:wasm",
    "dev": "next dev",
    "debug": "NODE_OPTIONS='--inspect' next",
    "prebuild": "pnpm copy:wasm",
    "build": "next build",
    "test:unit": "vp test",
    "test:unit:watch": "vp test watch",
    "test:unit:update-snapshots": "vp test -u",
    "test:e2e": "./scripts/docker-e2e.sh",
    "test:e2e:update-snapshots": "./scripts/docker-e2e.sh --update-snapshots",
    "test:e2e:show-report": "playwright show-report ./.playwright/test-report",
    "start": "next start",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "lint:fix-unsafe": "vp lint --fix-dangerously && vp fmt",
    "ncu": "npx npm-check-updates -u",
    "verify": "pnpm lint && pnpm test:unit && pnpm build",
    "playwright:install": "pnpm playwright install --with-deps chromium",
    "copy:wasm": "mkdir -p ./public && cp ./node_modules/@resvg/resvg-wasm/index_bg.wasm ./public/resvg_bg.wasm",
    "postinstall": "pnpm copy:wasm",
    "prepare": "is-ci || husky"
  },
  "engines": {
    "node": "26"
  },
  "packageManager": "pnpm@11.28.5",
  "dependencies": {
    "@next/third-parties": "^16.4.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "badgen": "^3.3.2",
    "clsx": "^2.1.1",
    "copee": "^1.0.6",
    "hero-patterns": "^2.1.0",
    "is-ci": "^4.1.0",
    "next": "^16.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "satori": "^0.57.2",
    "server-only": "^0.0.1",
    "simple-icons": "^16.35.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "daisyui": "^5.7.50",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "browserslist": [
    "last 1 version",
    "> 1%"
  ]
}
